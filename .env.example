# Frontend config. VITE_* is bundled into the client: only the shared API_TOKEN goes here, never HA_TOKEN.
# Empty VITE_API_URL = same origin (the Vite dev proxy forwards /api).
VITE_API_URL=
VITE_API_TOKEN=
# mock | live. Unset: mock in dev, live in production builds.
VITE_API_MODE=
# Backend the Vite dev proxy forwards /api to (dev only).
VITE_PROXY_TARGET=http://localhost:3003
